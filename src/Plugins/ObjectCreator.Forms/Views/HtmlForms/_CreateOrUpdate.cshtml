@helper TabElementGrid()
{
	if (Model.Id == 0)
	{
		<p>@T("Admin.SaveBeforeEdit")</p>
		return;
	}

	<div>
		@(Html.Telerik().Grid<FormControlDetailsModel>()
					.Name("html-form-control-grid")
					//.BindTo(Model.FormControls)
					.DataKeys(keys => keys.Add(x => x.Id).RouteKey("Id"))
					.DataBinding(dataBinding => dataBinding
						.Ajax()
						.Select("HtmlFormControlList", "HtmlForms", new { id = Model.Id })
						.Delete("HtmlFormControlDelete", "HtmlForms", new { id = Model.Id })
					)
					.Columns(columns =>
					{
						columns.Bound(x => x.Name)
							.ClientTemplate("<a href='" + @Url.Action("EditControl", "HtmlForms", new { area = "ObjectCreator.Forms" }) + "?id=<#= Id #>'><#= Name #></a>")
							.Template(x => "<a href='" + @Url.Action("EditControl", "HtmlForms", new { id = x.Id, area = "ObjectCreator.Forms" }) + "'>" + x.Name + "</a>")
							.Width(200);
						columns.Bound(x => x.IsActive)
							.Template(item => @Html.SymbolForBool(item.IsActive))
							.ClientTemplate(@Html.SymbolForBool("IsActive"))
							.Width(150)
							.Centered();
						columns.Bound(x => x.IsVisible)
							.Template(item => @Html.SymbolForBool(item.IsVisible))
							.ClientTemplate(@Html.SymbolForBool("IsVisible"))
							.Width(150)
							.Centered();
						columns.Bound(x => x.IsMandatory)
							.Template(item => @Html.SymbolForBool(item.IsMandatory))
							.ClientTemplate(@Html.SymbolForBool("IsMandatory"))
							.Width(150)
							.Centered();
			            //columns.Bound(x => x.ElementType.ToString());
			            //columns.Bound(x => x.InputType.ToString());
			            columns.Bound(x => x.ControlId).ReadOnly();
						columns.Bound(x => x.DisplayOrder)
							.Centered();
						columns.Command(commands =>
						{
							commands.Custom("edit-html-form-control").Text(T("Common.Edit"));
							commands.Delete().Localize(T);
						}).Width("12%").HtmlAttributes(new { align = "right" });
					})
					.ToolBar(commands =>
					{
						commands.Custom()
							.Text(T("Plugins.SmartStore.Forms.AddNewControl").Text)
							.Action("CreateControl", "HtmlForms", new { formId = Model.Id })
							.HtmlAttributes(new { @class = "btn btn-primary" });
					}))
	</div>

	<script type="text/javascript">
		$(function () {
				//Categories
			$('#html-form-control-grid').on('click', '.t-grid-edit-html-form-control', function (e) {
				e.preventDefault();
				var grid = $('#html-form-control-grid').data('tGrid');
				var tr = $(this).closest('tr');
				var id = grid.dataItem(tr).Id;
				var href = '@Url.Action("EditControl", "HtmlForms", new { area = "ObjectCreator.Forms" })?id=' + id + '&btnId=btnRefresh&formId=html-form-control-grid';

				location.replace(href);

				return false;
			});
		});
	</script>
}

@helper TokenInfoDescription()
{
	<div class="table-responsive">
		<table class="table admin-table">
			<thead>
				<tr>
					<th>@T("Plugins.SmartStore.Forms.ControlDetails")</th>
					<th>@T("Admin.Common.Placeholder")</th>
				</tr>
			</thead>
            <tbody>
                @foreach (var elem in Model.FormControls)
                {
                    <tr>
                        <td>@elem.Name</td>
                        <td>{{ @(Model.Name + "." + (elem.MessageTokenName.HasValue() ? elem.MessageTokenName : elem.ControlId)) }}</td>
                    </tr>
                }

                @if (Model.ReplacementFor != null && Model.ReplacementFor.Equals("EmailWishlist"))
                {
                    <tr>
                        <td>Products</td>
                        <td>{{ @(Model.Name + ".Products") }}</td>
                    </tr>
                    <tr>
                        <td>WishlistUrl</td>
                        <td>{{ @(Model.Name + ".WishlistUrl") }}</td>
                    </tr>
                }
            </tbody>
		</table>
	</div>
}

<script type="text/javascript">
    $(function () {

		// show/hide file name pattern descriptions
		$('#TokenInfoLink').click(function () {
			var descriptions = $('#TokenInfoDescription');
			$('#TokenInfoLink').html((descriptions.is(':visible') ?
				@T("Plugins.SmartStore.Forms.ShowTokens").JsText : @T("Plugins.SmartStore.Forms.HideTokens").JsText) + '…');
			descriptions.toggleClass("d-none");
		});

        $("#@Html.FieldIdFor(model => model.FormDisplayType)").change(toggleReplacementData);
        toggleReplacementData();

        function toggleReplacementData() {

			switch ($('#@Html.FieldIdFor(model => model.FormDisplayType)').val()) {
			  case 'Replacement':
				$('.pnlDeveloperData').hide();
				$('.pnlEntityIds').hide();
				$('.pnlTopicSystemname').hide();
				$('.pnlProductTabIndex').hide();
				$('.pnlWidgetZone').hide();
				$('.pnlReplacementFor').show();
				break;
			  case 'Topic':
				$('.pnlDeveloperData').hide();
				$('.pnlEntityIds').hide();
				$('.pnlProductTabIndex').hide();
				$('.pnlReplacementFor').hide();
				$('.pnlTopicSystemname').show();
                $('.pnlWidgetZone').show();
				break;
			  case 'Categories':
				$('.pnlDeveloperData').hide();
				$('.pnlTopicSystemname').hide();
				$('.pnlProductTabIndex').hide();
				$('.pnlReplacementFor').hide();
				$('.pnlEntityIds').show();
                $('.pnlWidgetZone').show();
				$('.pnlEntityIds .input-group-append').hide();
				break;
			  case 'Products':
				$('.pnlDeveloperData').hide();
				$('.pnlTopicSystemname').hide();
				$('.pnlReplacementFor').hide();
				$('.pnlProductTabIndex').show();
				$('.pnlEntityIds').show();
				$('.pnlEntityIds .input-group-append').show();
                $('.pnlWidgetZone').show();
				break;
			  case 'ProductsInCategories':
				$('.pnlDeveloperData').hide();
				$('.pnlTopicSystemname').hide();
				$('.pnlReplacementFor').hide();
				$('.pnlProductTabIndex').show();
				$('.pnlEntityIds').show();
                $('.pnlWidgetZone').show();
				$('.pnlEntityIds .input-group-append').hide();
				break;
			  case 'Widgetzone':
				$('.pnlDeveloperData').hide();
				$('.pnlTopicSystemname').hide();
				$('.pnlEntityIds').hide();
				$('.pnlProductTabIndex').hide();
				$('.pnlReplacementFor').hide();
                $('.pnlWidgetZone').show();
				break;
			  case 'Developer':
				$('.pnlEntityIds').hide();
				$('.pnlTopicSystemname').hide();
                $('.pnlWidgetZone').hide();
				$('.pnlProductTabIndex').hide();
				$('.pnlReplacementFor').hide();
				$('.pnlDeveloperData').show();
				break;
			  default:

				break;
			}
        }
    });
</script>