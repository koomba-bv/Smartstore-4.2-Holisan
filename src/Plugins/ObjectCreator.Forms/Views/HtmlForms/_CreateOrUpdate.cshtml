@model ConfigurationDetailsModel
@using SmartStore.Web.Framework;
@using SmartStore.HtmlForms.Models;
@using SmartStore.Web.Framework.UI;
@using SmartStore.HtmlForms.Domain;
@using Telerik.Web.Mvc;
@using Telerik.Web.Mvc.UI;
@{
	Layout = "~/Administration/Views/Shared/_AdminLayout.cshtml";
	ViewBag.Title = T("Plugins.SmartStore.Forms.FormDetails").Text + ": " + Model.Name.Truncate(60, "...");
}

@using (Html.BeginForm())
{
	<div class="section-header">
		<div class="title">
			<i class="fa fa-link"></i>
			@T("Plugins.SmartStore.Forms.FormDetails"): <span title="@Model.Name">@Model.Name.Truncate(60, "...")</span>
			<a href="@Url.Action("ConfigurePlugin", "Plugin", new { area = "Admin", systemName = "ObjectCreator.Forms" })">(@T("Admin.Common.BackToList"))</a>
		</div>
		<div class="options">
			<button type="submit" name="save" value="save" class="btn btn-warning">
				<i class="fa fa-check"></i>
				<span>@T("Admin.Common.Save")</span>
			</button>
			@if (Model.Id != 0)
			{
				<button type="submit" id="delete-single" name="delete-single" value="delete-single" class="btn btn-danger" onclick='return confirm(@T("Admin.Common.AskToProceed").JsText);'>
					<span>@T("Admin.Common.Delete")</span>
				</button>
			}
		</div>
	</div>

	@Html.SmartStore().TabStrip().Name("html-forms-edit").Style(TabsStyle.Material).Items(x =>
	{
		x.Add().Text(T("Plugins.SmartStore.Forms.TabTitleSettings").Text).Content(TabEdit()).Selected(true);
		x.Add().Text(T("Plugins.SmartStore.Forms.TabTitleGrid").Text).Content(TabElementGrid());
	})
}

