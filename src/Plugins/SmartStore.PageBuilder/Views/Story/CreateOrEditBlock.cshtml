@model BlockContainer

@using SmartStore.PageBuilder;
@using SmartStore.PageBuilder.Models;

@{
    Layout = "_AdminPopupLayout";

    Html.AddScriptParts(true, "~/Plugins/SmartStore.PageBuilder/Scripts/pagebuilder.utils.js");
    Html.AddScriptParts(true, "~/Plugins/SmartStore.PageBuilder/Scripts/pagebuilder.overlays.js");

    Html.AddBodyAttribute("data-file-manager-url", base.FileManagerUrl);

    var isUpdate = Model.Id > 0;
    var action = isUpdate ? "BlockEditPopup" : "BlockAddPopup";

    ViewBag.Title = isUpdate
        ? T("Plugins.SmartStore.PageBuilder.Block.EditBlock", Model.Metadata.FriendlyName).Text
        : T("Plugins.SmartStore.PageBuilder.Block.AddBlock", Model.Metadata.FriendlyName).Text;
}

@using (Html.BeginForm(action, "Story", new { btnId = ViewBag.BtnId }, FormMethod.Post))
{
	@Html.AntiForgeryToken()

	<div class="section-header">
		<div class="title">
			<i class="@Model.Metadata.Icon"></i>
			@ViewBag.Title
		</div>
		<div class="options">
			<button type="submit" name="save" value="save" class="btn btn-@(isUpdate ? "warning" : "primary")">
				<i class="fa fa-save"></i>
				<span>@T("Admin.Common.Save")</span>
			</button>
			<button type="submit" name="save" value="save-continue" class="btn btn-secondary">
				<span>@T("Admin.Common.SaveContinue")</span>
			</button>
		</div>
	</div>

	@Html.ValidationSummary(false)
	@Html.HiddenFor(model => model.Id)
	@Html.HiddenFor(model => model.StoryId)
	@Html.HiddenFor(model => model.BlockType)
	@Html.HiddenFor(model => model.BlockClrType.AssemblyQualifiedName)

	//Model.RenderBlock(new[] { "Edit" }, this.Html);

	@Html.SmartStore().TabStrip().Name("storyblock-edit").Style(TabsStyle.Material).Items(x =>
    {
        x.Add().Text(Model.Metadata.FriendlyName).Content(Model.BlockToHtmlString(new[] { "Edit" }, this.Html).ToHtmlString()).Selected(true);
        x.Add().Text(T("Admin.Common.General").Text).Content(TabGeneral());
        x.Add().Text(T("Plugins.SmartStore.PageBuilder.Block.TabHeading.Background").Text).Content(Html.Partial("_Block.Background", Model).ToHtmlString());
        x.Add().Text(T("Plugins.SmartStore.PageBuilder.Block.TabHeading.Box").Text).Content(Html.Partial("_Block.Box", Model).ToHtmlString());
        x.Add().Text(T("Plugins.SmartStore.PageBuilder.Block.TabHeading.Effects").Text).Content(Html.Partial("_Block.Effects", Model).ToHtmlString());

        if (Model.BlockIsBindable && Model.DataBindingModel != null)
        {
            x.Add().Text(T("Plugins.SmartStore.PageBuilder.Block.TabHeading.DataBinding").Text).Content(Html.Partial("_Block.DataBinding", Model).ToHtmlString());
        }

		x.Add().Text(T("Common.Advanced").Text).Content(TabAdvanced());

        // generate an event
        EngineContext.Current.Resolve<IEventPublisher>().Publish(new TabStripCreated(x, "storyblock-edit", this.Html, this.Model));
    })
}

@helper TabGeneral()
