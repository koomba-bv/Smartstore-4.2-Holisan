@Html.SmartStore().TabStrip().Name("block-html-edit").Style(TabsStyle.Material).Items(x =>
{
    x.Add().Text(T("Plugins.SmartStore.PageBuilder.Heading.Settings.Title").Text).Content(TabTitle()).Selected(true);
    x.Add().Text(T("Plugins.SmartStore.PageBuilder.Heading.Settings.Tagline").Text).Content(TabTagline());
    x.Add().Text(T("Plugins.SmartStore.PageBuilder.Heading.Settings.SubTitle").Text).Content(TabSubTitle());
    x.Add().Text(T("Plugins.SmartStore.PageBuilder.Heading.Settings.Body").Text).Content(TabBody());
    x.Add().Text(T("Plugins.SmartStore.PageBuilder.Heading.Settings.Icon").Text).Content(TabIcon());
    x.Add().Text(T("Plugins.SmartStore.PageBuilder.Heading.Settings.Button").Text).Content(TabButton());
})

@Html.HiddenFor(model => model.BindEntityId)
@Html.HiddenFor(model => model.BindEntityName)

@helper TabTitle()
{
    <div class="adminContent">
        <div class="adminRow">
            <div class="adminTitle">
                @Html.SmartLabelFor(model => model.HideTitle)
            </div>
            <div class="adminData">
                @Html.CheckBoxFor(model => model.HideTitle, new { data_toggler_for = "#pnlTitle", data_toggler_reverse = "true" })
            </div>
        </div>
        <div id="pnlTitle">
            <div class="adminRow">
                <div class="adminTitle">
                    @Html.SmartLabelFor(model => model.TitleTag)
                </div>
                <div class="adminData">

                    <div class="btn-group btn-group-toggle" data-toggle="buttons">
                        @foreach (var item in StoryModelHelper.SelectOptions.TitleTags(T))
                        {
                            <label class="btn btn-secondary @(item.Value == Model.TitleTag ? "active" : "")">
                                <input type="radio"
                                       name="@Html.FieldNameFor(x => x.TitleTag)"
                                       value="@item.Value"
                                       autocomplete="off" @(item.Value == Model.TitleTag ? "checked" : "")> @item.Text
                                </label>
                            }
                    </div>

                    @Html.ValidationMessageFor(model => model.TitleTag)
                </div>
            </div>
            <div class="adminRow">
                <div class="adminTitle">
                    @Html.SmartLabelFor(model => model.TitleSize)
                </div>
                <div class="adminData">
                    @Html.DropDownListFor(model => model.TitleSize, StoryModelHelper.SelectOptions.TitleSizes(T), T("Common.Unspecified"))
                    @Html.ValidationMessageFor(model => model.TitleSize)
                </div>
            </div>
            <div>
                @Html.EditorFor(model => model.TitleFontStylesModel, "FontStyles")
            </div>
        </div>
        <div class="adminRow">
            <div class="admin-config-group">
                <div class="title">CSS</div>
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle">
                @Html.SmartLabelFor(model => model.TitleCssClass)
            </div>
            <div class="adminData">
                @Html.TextBoxFor(model => model.TitleCssClass)
                @Html.ValidationMessageFor(model => model.TitleCssClass)
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle">
                @Html.SmartLabelFor(model => model.TitleCssStyle)
            </div>
            <div class="adminData">
                @Html.TextAreaFor(model => model.TitleCssStyle)
                @Html.ValidationMessageFor(model => model.TitleCssStyle)
            </div>
        </div>
    </div>
}

