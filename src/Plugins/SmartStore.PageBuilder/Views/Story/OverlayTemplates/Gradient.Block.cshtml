@model GradientOverlay

@using SmartStore.PageBuilder;

<div class="adminRow">
    <div class="adminTitle">
        @Html.SmartLabelFor(model => model.Color)
    </div>
    <div class="adminData">
        @Html.DropDownListFor(model => model.Color, StoryModelHelper.SelectOptions.BrandColors(T, GetThemeVariable("brand-colors")), T("Common.Unspecified"), new { @class = "theme-color-chooser" })
        @Html.ValidationMessageFor(model => model.Color)
    </div>
</div>
<div class="adminRow">
    <div class="adminTitle">
        @Html.SmartLabelFor(model => model.Brightness)
    </div>
    <div class="adminData">
        @Html.DropDownListFor(model => model.Brightness, StoryModelHelper.SelectOptions.GradientBrightness(T))
    </div>
</div>

<div class="adminRow">
    <div class="adminTitle">
        @Html.SmartLabelFor(model => model.Type)
    </div>
    <div class="adminData">
        @Html.EditorFor(model => model.Type)
    </div>
</div>
<div class="adminRow@(Model.Type == GradientType.Radial ? " d-none" : "")" data-gradient-type="linear">
    <div class="adminTitle">
        @Html.SmartLabelFor(model => model.LinearDir)
    </div>
    <div class="adminData">
        <div class="row xs-gutters select-gradient-lineardir">
            <div class="col">
                @Html.EditorFor(model => model.LinearDir)
            </div>
            <div class="col-auto">
                <div class="linear-gradient-preview" style="--angle: @(Model.LinearDir)deg"></div>
            </div>
        </div>
    </div>
</div>
<div class="adminRow@(Model.Type == GradientType.Linear ? " d-none" : "")" data-gradient-type="radial">
    <div class="adminTitle">
        @Html.SmartLabelFor(model => model.RadialDir)
    </div>
    <div class="adminData">
        @Html.DropDownListFor(model => model.RadialDir, StoryModelHelper.SelectOptions.RadialDirs(T))
    </div>
</div>
<div class="adminRow">
    <div class="adminTitle">
        @Html.SmartLabelFor(model => model.StartPos)
    </div>
    <div class="adminData">
        @Html.EditorFor(model => model.StartPos)
    </div>
</div>
<div class="adminRow">
    <div class="adminTitle">
        @Html.SmartLabelFor(model => model.EndPos)
    </div>
    <div class="adminData">
        @Html.EditorFor(model => model.EndPos)
    </div>
</div>
<div class="adminRow">
    <div class="adminTitle">
        @Html.SmartLabelFor(model => model.Repeat)
    </div>
    <div class="adminData">
        @Html.DropDownListForEnum(model => model.Repeat, new { @class = "select-gradient-repeat" })
    </div>
</div>
<div class="adminRow@(Model.Repeat == GradientRepeat.NoRepeat ? " d-none" : "")" data-gradient-repeat="true">
    <div class="adminTitle">
        @Html.SmartLabelFor(model => model.MidPos)
    </div>
    <div class="adminData">
        @Html.EditorFor(model => model.MidPos)
    </div>
</div>