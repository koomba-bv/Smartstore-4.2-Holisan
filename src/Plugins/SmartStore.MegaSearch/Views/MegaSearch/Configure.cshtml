@using SmartStore.MegaSearch;
@using SmartStore.MegaSearch.Models;
@using SmartStore.Core.Infrastructure;
@using SmartStore.Core.Events;
@using SmartStore.Web.Framework.Events;
@model ConfigurationModel
@{
    Layout = "";
}
<div class="plugin-actions">
	<button type="submit" name="save" class="btn btn-warning" value="save">
		<i class="fa fa-check"></i>
		<span>@T("Admin.Common.Save")</span>
	</button>
</div>

<div class="alert alert-info">
	@Html.Raw(T("Plugins.SmartStore.MegaSearch.AdminInstruction", Url.Action("Search", "Setting", new { area = "admin" })))
</div>

@{ Html.RenderAction("StoreScopeConfiguration", "Setting", new { area = "Admin" }); }
@Html.ValidationSummary(false)

@using (Html.BeginForm())
{
    <input type="hidden" name="ExpandedScopes" />
    <div id="ScopeList" class="mb-4">
	    @{ Html.RenderPartial("_ScopeList"); }
    </div>

	@(Html.SmartStore().TabStrip().Name("megasearch-config").Style(TabsStyle.Material).Position(TabsPosition.Top).Items(x =>
	{
		x.Add().Text(T("Common.General").Text).Content(TabGeneral()).Selected(true);
		x.Add().Text(T("Plugins.SmartStore.MegaSearch.TextAnalysis").Text).Content(TabTextAnalysis());
		
		EngineContext.Current.Resolve<IEventPublisher>().Publish(new TabStripCreated(x, "megasearch-config", this.Html, this.Model));
	}))
}

