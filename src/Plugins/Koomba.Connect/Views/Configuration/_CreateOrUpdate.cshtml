    <script>
        $(function () {
            $("#@Html.FieldIdFor(m => m.SynchronizeType)").change(toggleSyncType);
			$("#@Html.FieldIdFor(m => m.SmartType)").change(toggleType);

            toggleSyncType();

            function toggleSyncType() {
                var selectedItem = $("#@Html.FieldIdFor(m => m.SynchronizeType)").val();
                var smartTypes = $("#@Html.FieldIdFor(m => m.SmartType)")
                $.ajax({
                    cache: false,
                    type: "GET",
                    url: "@(Url.Action("GetSmartTypesBySyncType", "Configuration"))",
                    data: { "synchronizeType": selectedItem },
                    success: function (data) {
                        smartTypes.html('');
                        $.each(data, function (id, option) {
                            smartTypes.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                        smartTypes.trigger("change");
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        alert('Failed to retrieve smart types.')
                    }
                });
            }

            function toggleType() {
				var selectedSynchronizeType = $("#@Html.FieldIdFor(m => m.SynchronizeType)").val();
                var selectedSmartType = $("#@Html.FieldIdFor(m => m.SmartType)").val();

                $('.pnlUpdateQuery').hide();
                $('.pnlNewCardCodeQuery').hide();
                $('.pnlAllowCreate').hide();
                $('.pnlAllowEdit').hide();
                $('.getOrderNumber').hide();
                $('.pnlCustomerNumber').hide();

				if (selectedSynchronizeType == "@SynchronizeType.Export") {
                    $('.pnlInsertQuery').show();

					$('.pnlOnlyUpdate').hide();
                    $('.pnlKeyLogic').hide();
                    $('.pnlSapQuery').hide();

                    if (selectedSmartType == "@SmartType.Customer") {
                        $('.pnlNewCardCodeQuery').show();

                        $('.pnlUpdateQuery').show();
                        $('.pnlAllowCreate').show();
                        $('.pnlAllowEdit').show();
                    }

                    if (selectedSmartType == "@SmartType.Address") {
                        $('.pnlUpdateQuery').show();
                        $('.pnlAllowCreate').show();
                        $('.pnlAllowEdit').show();
                    }

                    if (selectedSmartType == "@SmartType.Order") {
                        $('.getOrderNumber').show();
                    }
				} else {
                    $('.pnlInsertQuery').hide();

					$('.pnlOnlyUpdate').show();
                    $('.pnlKeyLogic').show();
                    $('.pnlSapQuery').show();

                    if (selectedSmartType == "@SmartType.Address") {
                        $('.pnlCustomerNumber').show();
                    }
				}
			}
		});
    </script>
