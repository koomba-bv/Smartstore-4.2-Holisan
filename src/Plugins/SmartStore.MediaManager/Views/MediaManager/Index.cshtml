@model MediaManagerOptions

@using System.Globalization
@using SmartStore.MediaManager.Models

@{
    Layout = Model.Popup ? "_AdminPopupLayout" : "_AdminLayout";
    ViewBag.Title = T("Plugins.FriendlyName.SmartStore.MediaManager").Text;

    Html.AddBodyCssClass("spa-layout mm");

    Html.AddScriptParts(true, "~/bundles/vue");
    Html.AddScriptParts(true, "~/bundles/mediamanager");
    Html.AddScriptParts(true, "~/bundles/fileuploader");

    var resRoot = "Plugins.MediaManager.";
    var clientRes = new Dictionary<string, string>
    {
        ["createNew"] = T("Common.New"),
        ["createFolder"] = T(resRoot + "CreateFolder"),
        ["createFolderDialog"] = T(resRoot + "CreateFolderDialog"),
        ["renameFolder"] = T(resRoot + "RenameFolder"),
        ["deleteFolder"] = T(resRoot + "DeleteFolder"),
        ["deleteFolderDialog"] = T(resRoot + "DeleteFolderDialog"),
        ["folderMoved"] = T(resRoot + "FolderMoved"),
        ["folderCopied"] = T(resRoot + "FolderCopied"),
        ["folderWithFileDeleted"] = T(resRoot + "FolderWithFileDeleted"),
        ["folderWithFilesDeleted"] = T(resRoot + "FolderWithFilesDeleted"),
        ["foldersWithFileDeleted"] = T(resRoot + "FoldersWithFileDeleted"),
        ["foldersWithFilesDeleted"] = T(resRoot + "FoldersWithFilesDeleted"),
        ["renameFile"] = T(resRoot + "RenameFile"),
        ["deleteFile"] = T(resRoot + "DeleteFile"),
        ["deleteFiles"] = T(resRoot + "DeleteFiles"),
        ["trashFile"] = T(resRoot + "TrashFile"),
        ["trashFiles"] = T(resRoot + "TrashFiles"),
        ["restoreFileError"] = T(resRoot + "RestoreFileError"),
        ["restoreFilesError"] = T(resRoot + "RestoreFilesError"),
        ["fileMoved"] = T(resRoot + "FileMoved"),
        ["filesMoved"] = T(resRoot + "FilesMoved"),
        ["fileCopied"] = T(resRoot + "FileCopied"),
        ["filesCopied"] = T(resRoot + "FilesCopied"),
        ["fileRestored"] = T(resRoot + "FileRestored"),
        ["filesRestored"] = T(resRoot + "FilesRestored"),
        ["fileTrashed"] = T(resRoot + "FileTrashed"),
        ["filesTrashed"] = T(resRoot + "FilesTrashed"),
        ["fileDeleted"] = T(resRoot + "FileDeleted"),
        ["filesDeleted"] = T(resRoot + "FilesDeleted"),
        ["fileInUse"] = T(resRoot + "FileInUse"),
        ["filesInUse"] = T(resRoot + "FilesInUse"),
        ["mustCopyFileToAlbum"] = T(resRoot + "MustCopyFileToAlbum"),
        ["mustCopyFilesToAlbum"] = T(resRoot + "MustCopyFilesToAlbum"),
        ["viewModeList"] = T(resRoot + "ViewMode.List"),
        ["viewModeGrid"] = T(resRoot + "ViewMode.Grid"),
        ["viewModeTiles"] = T(resRoot + "ViewMode.Tiles"),
        ["mediaTypeImage"] = T("Admin.Configuration.Settings.Media.Type.Image"),
        ["mediaTypeVideo"] = T("Admin.Configuration.Settings.Media.Type.Video"),
        ["mediaTypeAudio"] = T("Admin.Configuration.Settings.Media.Type.Audio"),
        ["mediaTypeDocument"] = T("Admin.Configuration.Settings.Media.Type.Document"),
        ["mediaTypeText"] = T("Admin.Configuration.Settings.Media.Type.Text"),
        ["mediaTypeBin"] = T("Admin.Configuration.Settings.Media.Type.Bin"),
        ["imgSizeXs"] = T(resRoot + "ImgSize.Xs"),
        ["imgSizeSm"] = T(resRoot + "ImgSize.Sm"),
        ["imgSizeMd"] = T(resRoot + "ImgSize.Md"),
        ["imgSizeLg"] = T(resRoot + "ImgSize.Lg"),
        ["imgSizeXl"] = T(resRoot + "ImgSize.Xl"),
        ["facetType"] = T(resRoot + "Facet.Type"),
        ["facetExtension"] = T(resRoot + "Facet.Extension"),
        ["facetTag"] = T(resRoot + "Facet.Tag"),
        ["facetImgSize"] = T(resRoot + "Facet.ImgSize"),
        ["searchTermPlaceholder"] = T(resRoot + "SearchTermPlaceholder"),
        ["sortByX"] = T(resRoot + "SortByX"),
        ["reverseSortDir"] = T(resRoot + "ReverseSortDir"),
        ["detectTracks"] = T(resRoot + "DetectTracks"),
        ["detectTracksInfo"] = T(resRoot + "DetectTracksInfo"),
        ["detectTracksComplete"] = T(resRoot + "DetectTracksComplete"),
        ["thumbSize"] = T(resRoot + "ThumbSize"),
        ["fileName"] = T(resRoot + "FileName"),
        ["fileSize"] = T(resRoot + "FileSize"),
        ["fileDimensions"] = T(resRoot + "FileDimensions"),
        ["fileDate"] = T(resRoot + "FileDate"),
        ["fileUpdatedDate"] = T(resRoot + "FileUpdatedDate"),
        ["fileUrl"] = T(resRoot + "FileUrl"),
        ["invertSelection"] = T(resRoot + "InvertSelection"),
        ["cut"] = T("Common.Cut"),
        ["copy"] = T("Common.Copy"),
        ["paste"] = T("Common.Paste"),
        ["selectAll"] = T("Common.SelectAll"),
        ["edit"] = T("Common.Edit"),
        ["batchEdit"] = T(resRoot + "BatchEdit"),
        ["delete"] = T("Common.Delete"),
        ["deletePermanent"] = T(resRoot + "DeletePermanent"),
        ["download"] = T("Common.Download"),
        ["upload"] = T("Common.Upload"),
        ["rename"] = T("Common.Rename"),
        ["replace"] = T("Common.Replace"),
        ["save"] = T("Common.Save"),
        ["cancel"] = T("Common.Cancel"),
        ["close"] = T("Common.Close"),
