@model StoryModel

@using SmartStore.PageBuilder.Models

@{
	Layout = "_AdminLayout";

	var isUpdate = Model.Id > 0;
    var isRtl = WorkContext.WorkingLanguage.Rtl;

	ViewBag.Title = T("Plugins.SmartStore.PageBuilder.Story." + (isUpdate ? "Edit" : "AddNew")).Text + (isUpdate ? " - " + Model.SystemName : "");

	Html.AddBodyCssClass("spa-layout story-editor");
	Html.AddScriptParts(true, "~/Plugins/SmartStore.PageBuilder/Scripts/pagebuilder.admin.js");
    Html.AddScriptParts(true, "~/Plugins/SmartStore.PageBuilder/Scripts/pagebuilder.overlays.js");
    Html.AddScriptParts(true, "~/Plugins/SmartStore.PageBuilder/Scripts/html2canvas.min.js");

    Html.AddBodyAttribute("data-file-manager-url", base.FileManagerUrl);
}

<div class="section-header nofix flex-grow-0">
	<div class="title">
		<span>@ViewBag.Title</span>
		<a href="@Url.Action("ConfigurePlugin", "Plugin", new { area = "Admin", systemName = "SmartStore.PageBuilder" })">(@T("Admin.Common.BackToList"))</a>
	</div>
	<div class="options">
		<div class="btn-group">
			<button type="button" class="btn btn-secondary btn-story-save disabled" disabled title="@T("Plugins.SmartStore.PageBuilder.SaveContinue")">
				<i class="fa fa-save"></i>
				<span>@T("Common.Save")</span>
			</button>
			<button type="button" id="btn-story-save-split" class="btn btn-secondary dropdown-toggle dropdown-toggle-split" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></button>
			<div class="dropdown-menu dropdown-menu-right">
				<a class="dropdown-item" id="btn-story-saveastemplate" href="#" data-url="@Url.Action("SaveAsTemplate", new { id = Model.Id })">
					@T("Plugins.SmartStore.PageBuilder.Story.SaveAsTemplate")
				</a>
			</div>
		</div>

		<div class="btn-group mx-1" role="group">
			<button type="button" id="btn-undo" class="btn btn-icon btn-secondary" disabled title="@T("Plugins.SmartStore.PageBuilder.Undo")">
				<i class="fa fa-undo"></i>
			</button>
			<button type="button" id="btn-redo" class="btn btn-icon btn-secondary" disabled title="@T("Plugins.SmartStore.PageBuilder.Redo")">
				<i class="fa fa-redo"></i>
			</button>
		</div>
		<div class="btn-group mx-1" role="group">
			<button type="button" id="btn-story-clone-shim" data-target="#btn-story-clone" class="btn btn-secondary@(isUpdate ? "" : " d-none")" title="@T("Plugins.SmartStore.PageBuilder.Clone")">
				<i class="fa fa-clone"></i>
			</button>
			<button type="button" id="btn-story-export-shim" data-target="#btn-story-export" class="btn btn-secondary@(isUpdate ? "" : " d-none")" title="@T("Common.Export")">
				<i class="fa-fw fa fa-upload"></i>
			</button>
		</div>
		<div class="btn-group mr-1" role="group">
			<button type="button" id="btn-story-preview-toggle" class="btn btn-icon btn-secondary" title="@T("Plugins.SmartStore.PageBuilder.PreviewMode")">
				<i class="fa fa-eye"></i>
			</button>
			<button type="button" id="btn-story-fullscreen-toggle" class="btn btn-icon btn-secondary" title="@T("Plugins.SmartStore.PageBuilder.FullScreen")">
				<i class="fa fa-expand"></i>
			</button>
		</div>
		<button type="button" id="btn-story-delete-shim" data-target="#btn-story-delete" class="btn btn-secondary btn-to-danger@(isUpdate ? "" : " d-none")" title="@T("Admin.Common.Delete")">
			<i class="far fa-trash-alt"></i>
		</button>
	</div>
</div>

<div class="d-flex flex-grow-1">
    <div class="story-container d-flex flex-column flex-grow-1" data-storyid="@Model.Id" data-systemname="@Model.SystemName" data-organize-blocks="@(Model.OrganizeBlocks.ToString().ToLower())">
	    <div id="device-resizer-container" class="pb-2 flex-grow-0">
		    <div class="device-markers">
			    <div class="device-marker device-marker-xs" data-icon="fa-mobile-alt" data-title="@T("Plugins.SmartStore.PageBuilder.Story.Mobile")">
				    <i class="device-icon fa fa-fw fa-mobile-alt"></i>
				    <span class="font-weight-medium">@T("Plugins.SmartStore.PageBuilder.Story.Mobile")</span>
			    </div>
			    <div class="device-marker device-marker-sm" data-icon="fa-mobile-alt fa-rotate-90" data-title="@T("Plugins.SmartStore.PageBuilder.Story.MobileLandscape")">
				    <i class="device-icon fa fa-fw fa-mobile-alt fa-rotate-90"></i>
				    <span>@Html.Raw(T("Plugins.SmartStore.PageBuilder.Story.MobileLandscapeFormatted"))</span>
			    </div>
			    <div class="device-marker device-marker-md" data-icon="fa-tablet-alt" data-title="@T("Plugins.SmartStore.PageBuilder.Story.Tablet")">
				    <i class="device-icon fa fa-fw fa-tablet-alt"></i>
				    <span class="font-weight-medium">@T("Plugins.SmartStore.PageBuilder.Story.Tablet")</span>
			    </div>
			    <div class="device-marker device-marker-lg" data-icon="fa-tablet-alt fa-rotate-90" data-title="@T("Plugins.SmartStore.PageBuilder.Story.TabletLandscape")">
				    <i class="device-icon fa fa-fw fa-tablet-alt fa-rotate-90"></i>
				    <span>@Html.Raw(T("Plugins.SmartStore.PageBuilder.Story.TabletLandscapeFormatted"))</span>
			    </div>
			    <div class="device-marker device-marker-xl" data-icon="fa-desktop" data-title="@T("Plugins.SmartStore.PageBuilder.Story.Desktop")">
				    <i class="device-icon fa fa-fw fa-desktop mr-1"></i>
				    <span class="font-weight-medium">@T("Plugins.SmartStore.PageBuilder.Story.Desktop")</span>
			    </div>
		    </div>
		    <div class="device-slider-container">
			    <div class="device-tracks">
				    <div class="device-track device-track-xs"></div>
				    <div class="device-track device-track-sm"></div>
				    <div class="device-track device-track-md"></div>
				    <div class="device-track device-track-lg"></div>
				    <div class="device-track device-track-xl active"></div>
			    </div>
			    <input type="range" class="form-control-range" id="device-slider" min="0" max="1459" step="1" value="1459">
		    </div>
	    </div>

		<div class="story-frame-wrap flex-grow-1">

			<!-- Story Grid -->
			<iframe class="story-frame" src="@Url.Action("Story", new { framed = true, storyId = Model.Id, viewMode = StoryViewMode.GridEdit })"></iframe>
			
			<!-- Block Manager -->
            <div id="bm-drop-indicator"></div>
			<div class="block-manager-wrap h-100 show">
				<div class="block-manager">
					<!-- Lazy -->
				</div>
				<div id="block-manager-template" class="d-none">
					<div class="bm-block" data-id="0" draggable="@Model.OrganizeBlocks.ToString().ToLower()">
						<div class="bm-block-inner">
							<div class="bm-commands dropdown">
								<button type="button" class="btn btn-sm btn-primary btn-flat btn-no-border rounded-0 dropdown-toggle px-2 py-2 btn-block-menu" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
									<i class="fa fa-ellipsis-v"></i>
								</button>
								<div class="dropdown-menu @(isRtl ? "dropdown-menu-right" : "dropdown-menu-left")">
									<a class="bm-command dropdown-item" href="#" data-action="levelup">
										<i class="fa fa-fw fa-angle-up"></i>
										<span>@T("Common.MoveUp")</span>
									</a>
									<a class="bm-command dropdown-item" href="#" data-action="leveldown">
										<i class="fa fa-fw fa-angle-down"></i>
										<span>@T("Common.MoveDown")</span>
									</a>
									<div class="dropdown-divider"></div>
									<a class="bm-command dropdown-item" data-action="copy" href="#" data-url="@Url.Action("BlockClone", new { id = "__blockid__" })">
										<i class="fa fa-fw fa-copy"></i>
										<span>@T("Plugins.SmartStore.PageBuilder.Copy")</span>
									</a>
									<a class="bm-command dropdown-item" data-action="delete" href="#" data-url="@Url.Action("BlockDelete", new { id = "__blockid__" })">
										<i class="far fa-fw fa-trash-alt"></i>
										<span>@T("Admin.Common.Delete")</span>
									</a>
									<div class="dropdown-divider"></div>
									<a class="bm-command dropdown-item" data-action="edit" href="#" data-url="@Url.Action("BlockEditPopup", new { id = "__blockid__", btnId = "btn-refresh" })">
										<i class="fa fa-fw fa-cog"></i>
										<span>@T("Admin.Common.Edit")&hellip;</span>
									</a>
									<a class="bm-command dropdown-item d-none" data-action="childstory" href="#" data-url="@Url.Action("Editor", new { id = "__storyid__" })">
										<i class="fa fa-fw fa-th-large"></i>
										<span>@T("Plugins.SmartStore.PageBuilder.Story.Edit")</span>
									</a>
								</div>
							</div>
							<div class="bm-display" title="">
								<i class="fa fa-fw fa-eye"></i>
							</div>
							<div class="bm-icon">
								<i class="fab fa-fw fa-html5"></i>
							</div>
							<div class="bm-title text-truncate"></div>
						</div>
					</div>
				</div>
			</div>
		</div>
	    
    </div>
</div>

@using (Html.BeginZoneContent("aftermaincontent", key: "sidebar"))
{
	<div class="se-tabs se-block d-none">
		<div class="px-3 mb-3 text-white d-inline-flex flex-nowrap align-items-end">
			<h5 class="m-0">
				@T("Plugins.SmartStore.PageBuilder.Story.EditMode")
			</h5>
			<div class="ml-auto blockmode-icon">
				<i class="fa fa-2x fa-desktop"></i>
			</div>
		</div>
	</div>
	<form class="se-devicestate se-sidebar se-block d-none">
		@{ Html.RenderPartial("_Sidebar.DeviceState", Model); }
	</form>

	<nav class="se-tabs se-story">
		<ul class="nav nav-tabs nav-tabs-line nav-inverse row no-gutters">
			<li class="nav-item col">
				<a href="#se-layout" data-toggle="tab" class="nav-link active">@T("Plugins.SmartStore.PageBuilder.SideBar.Layout")</a>
			</li>
			<li class="nav-item col">
				<a href="#se-bg" data-toggle="tab" class="nav-link">@T("Plugins.SmartStore.PageBuilder.Background")</a>
			</li>
			<li class="nav-item col">
				<a href="#se-blocks" data-toggle="tab" class="nav-link">@T("Plugins.SmartStore.PageBuilder.Story.Blocks")</a>
			</li>
		</ul>
	</nav>

	var action = isUpdate ? "EditStory" : "CreateStory";
	using (Html.BeginForm(action, "Story", FormMethod.Post, new { @class = "se-stage se-sidebar se-story tab-content", id = "story-sidebar-form" }))
	{
		@Html.HiddenFor(model => model.Id)
		@Html.HiddenFor(model => model.CreatedOnUtc)
		@Html.HiddenFor(model => model.Targets)
		@Html.HiddenFor(model => model.AllDeviceStates)

		@Html.Hidden("CategorySelectUrl", Url.Action("AllCategories", "Category", new { area = "admin" }))
		@Html.Hidden("ManufacturerSelectUrl", Url.Action("AllManufacturers", "Manufacturer", new { area = "admin" }))
		@Html.Hidden("TopicSelectUrl", Url.Action("AllTopics", "Topic", new { area = "admin", includeHomePage = true }))
		@Html.Hidden("ProductSelectUrl", Url.Action("Picker", "Entity", new { area = "" }))

		<button type="button" class="d-none" id="btn-refresh" data-href="@Url.Action("Story", new { framed = true, storyId = Model.Id })"></button>
		<button type="submit" class="d-none" id="btn-story-clone" name="clone" value="clone"></button>
        <button type="submit" class="d-none" id="btn-story-export" name="export" value="export"></button>
		<button type="submit" class="d-none" id="btn-story-delete" name="delete" value="delete"></button>

		<div class="tab-pane fade show active" id="se-layout">
			@Html.Partial("_Sidebar.General", Model)
		</div>
		<div class="tab-pane fade" id="se-bg">
			@Html.Partial("_Sidebar.Background", Model)
		</div>
		<div class="tab-pane se-container fade" id="se-blocks" data-addurl="@Url.Action("BlockAddPopup", new { storyId = Model.Id, btnId = "btn-refresh" })">
			@if (isUpdate)
			{
				<div class="form-row">
					@foreach (var handler in Model.AvailableBlockTypes.Where(x => !x.IsInternal))
					{
						<div class="col-lg-6" style="padding-bottom: 10px">
							@*Firefox doesn't want to drag & drop buttons!*@
							<a href="javascript:void(0)" class="btn btn-light btn-3d btn-block btn-add-block text-left bg-white" draggable="true" data-blocktype="@handler.SystemName">
								<i class="@handler.Icon fa-fw fs-h6"></i>
								<span>@handler.FriendlyName</span>
							</a>
						</div>
					}
				</div>
			}
			else
			{
				<p class="text-muted">@T("Plugins.SmartStore.PageBuilder.Story.SaveBeforeAddingBlocks")</p>
				<button type="button" class="btn btn-warning btn-block btn-story-save" title="@T("Admin.Common.SaveContinue")">
					<i class="fa fa-save"></i>
					<span>@T("Admin.Common.SaveContinue")</span>
				</button>
			}
		</div>
	}
}

@{Html.SmartStore().Window()
	.Name("save-as-template-dialog")
	.Title(T("Plugins.SmartStore.PageBuilder.Story.SaveAsTemplate"))
	.Content(Html.Partial("_Story.SaveAsTemplate", Model.Template).ToHtmlString())
	.FooterContent(@<text>
		<button class="btn btn-secondary btn-flat" data-dismiss="modal">@T("Common.Cancel")</button>
		<button type="button" class="btn btn-primary"><span>@T("Common.OK")</span></button>
	</text>)
	.Render();
}

@Html.DeleteConfirmation("DeleteStory", "btn-story-delete")

<iframe id="thumb-frame" src="" data-url="@Url.Action("Story", new { framed = true, createThumbnail = true, storyId = Model.Id, viewMode = StoryViewMode.Public })"></iframe>

<script>
	$(function () {
		var editor = new StoryEditor();
        var ctlTarget;

		@foreach (var info in Model.TargetInfos)
		{
			<text>ctlTarget = editor.generateTargetControl('@info.Type', '@info.Value', '@info.Label', @info.Gone.ToString().ToLower());</text>
			<text>editor.targetsContainer.append(ctlTarget);</text>
		}

        SmartStore.StoryEditor = editor;

        window.EditorRes = {
		    @foreach (var key in new[]
            {
                "Plugins.SmartStore.PageBuilder.Story.SaveStory",
                "Plugins.SmartStore.PageBuilder.Story.SaveStoryConfirm",
                "Plugins.SmartStore.PageBuilder.Story.UploadThumbnailNote",
                "Plugins.SmartStore.PageBuilder.Story.Visible",
                "Plugins.SmartStore.PageBuilder.Story.NotVisible",
                "Plugins.SmartStore.PageBuilder.Story.UnspecifiedVisibility",
                "Plugins.SmartStore.PageBuilder.Story.Inherited"
            })
            {
			    <text>"@(Html.Raw(key))": @(T(key).JsText),</text>
		    }
        };
	});
</script>