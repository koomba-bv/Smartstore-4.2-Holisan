@model ErrorBlock

@using SmartStore.PageBuilder.Blocks

@{ 
	if (Model.Exception == null)
	{
		return;
	}
}

<div class="pr-3 pt-3 pb-3" style="max-height: 500px; overflow: auto;">
	<div>
		@Model.Exception.Message
	</div>

	@if (Model.Exception.InnerException != null)
	{
		<div class="font-weight-medium mt-3 pb-2">Inner Exception:</div>
		<div style="font-size: 80%">
			@Model.Exception.InnerException
		</div>
	}
</div>
