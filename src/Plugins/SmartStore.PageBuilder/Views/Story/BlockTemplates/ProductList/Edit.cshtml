    <div id="product-picker" class="adminRow">
        <div class="adminTitle">
            @Html.SmartLabelFor(model => model.ProductIds)
        </div>
        <div class="adminData">
            <div class="input-group">
                @Html.EditorFor(model => model.ProductIds)
