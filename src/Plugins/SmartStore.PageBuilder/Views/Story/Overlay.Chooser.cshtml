@{
    Layout = "";
    var isRtl = WorkContext.WorkingLanguage.Rtl;
}


<button class="btn btn-secondary btn-flat dropdown-toggle" type="button" data-toggle="dropdown">
    <i class="fa fa-plus"></i>
    <span>@T("Plugins.SmartStore.PageBuilder.Overlays.AddLayer")</span>
</button>
<div class="dropdown-menu @(isRtl ? "dropdown-menu-right" : "dropdown-menu-left")">
    <a class="dropdown-item overlay-add" href="#" data-type="@(typeof(ImageOverlay).AssemblyQualifiedName)">
        <i class="far fa-fw fa-lg fa-image"></i>
        <span>@T("Plugins.SmartStore.PageBuilder.Background.PictureId")</span>
    </a>
    <a class="dropdown-item overlay-add" href="#" data-type="@(typeof(VideoOverlay).AssemblyQualifiedName)">
        <i class="fas fa-fw fa-lg fa-film"></i>
        <span>@T("Plugins.SmartStore.PageBuilder.SideBar.Video")</span>
    </a>
    <a class="dropdown-item overlay-add" href="#" data-type="@(typeof(ColorOverlay).AssemblyQualifiedName)">
        <i class="fas fa-fw fa-lg fa-fill-drip"></i>
        <span>@T("Plugins.SmartStore.PageBuilder.SideBar.Color")</span>
    </a>
    <a class="dropdown-item overlay-add" href="#" data-type="@(typeof(GradientOverlay).AssemblyQualifiedName)">
        <i class="fa fa-fw fa-lg fa-void d-none">
            <span class="d-inline-block radial-gradient gradient-secondary rounded" style="--gdir: circle at left top; width: 18px; height: 18px; border: 1px solid #888"></span>
        </i>
        <i class="fas fa-fw fa-lg fa-adjust" style="transform: rotate(-45deg)"></i>
        <span>@T("Plugins.SmartStore.PageBuilder.SideBar.Gradient")</span>
    </a>
    <a class="dropdown-item overlay-add" href="#" data-type="@(typeof(ShadeOverlay).AssemblyQualifiedName)">
        <i class="fa fa-fw fa-lg fa-void">
            <span class="d-inline-block scrim-linear-gradient gradient-black rounded" style="width: 18px; height: 18px; border: 1px solid #888;"></span>
        </i>
        <span>@T("Plugins.SmartStore.PageBuilder.SideBar.Shade")</span>
    </a>
    <a class="dropdown-item overlay-add" href="#" data-type="@(typeof(DividerOverlay).AssemblyQualifiedName)">
        <i class="fa fa-fw fa-lg fa-void">
            <span class="d-inline-block bg-gray" style="width: 18px; height: 18px; position: relative">
                <img src="@Url.RouteUrl("SmartStore.PageBuilder.DividerPreview", new { name = "Skew1" })" style="display: block; width: 100%; height: 50%; position: absolute; left: 0; top: auto; bottom: 0;" />
            </span>
        </i>
        <span>@T("Plugins.SmartStore.PageBuilder.Overlays.Divider")</span>
    </a>
</div>
