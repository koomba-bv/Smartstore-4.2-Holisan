<script>
    $(function () {
        // Configuration options display handling
        const styleEl = $('#gallery-style');
        const zoomerEl = $('#gallery-zoomer');
        const revealEl = $('#gallery-reveal');
        const flatEl = $('#gallery-flat');
        const hoverEl = $('#gallery-hover');
        const gapEl = $('#gallery-gap');
        const colEl = $('#gallery-column-count');
        const fitEl = $('#gallery-object-fit');
        const mediaSizeEl = $('#gallery-media-size');
        const indicatorsEl = $('#gallery-indicators');
        const intervalEl = $('#gallery-interval');
        const alignHorizontalEl = $('#gallery-align-horizontal');
        const borderShadow = $('#gallery-border-shadow');
        const paddings = $('#gallery-paddings');
        const aspectRatio = $('#gallery-aspect-ratio');

        var toggleContextSettings = function () {
            const selectedValue = styleEl.find('option:selected').val();
            switchOff(hoverEl, selectedValue, 'Gallery', 'Slider');
            switchOff(revealEl, selectedValue, 'Gallery', 'Slider');
            switchOff(flatEl, selectedValue, 'Gallery', 'Slider');
            switchOff(gapEl, selectedValue, 'Slider', 'Gallery');
            switchOff(paddings, selectedValue, 'Gallery')
            switchOff(borderShadow, selectedValue, 'Gallery')
            switchOn(fitEl, selectedValue, 'Grid');
            switchOn(mediaSizeEl, selectedValue, 'Grid', 'Justify');
            switchOn(zoomerEl, selectedValue, 'Gallery');
            switchOn(colEl, selectedValue, 'Masonry');
            switchOn(indicatorsEl, selectedValue, 'Slider');
            switchOn(intervalEl, selectedValue, 'Slider');
            switchOn(alignHorizontalEl, selectedValue, 'Justify');
            switchOn(aspectRatio, selectedValue, 'Slider', 'Gallery');
        }

        toggleContextSettings();
        styleEl.on('change', toggleContextSettings);

        const fuContainer = $(this).find('.fu-container');
        const previewContainer = fuContainer.find('.preview-container');
        const previewTemplate = fuContainer.find('.file-preview-template');
        const dropzone = Dropzone.forElement(fuContainer[0]);
        const hiddenField = document.getElementById('gallery-media-ids');
        const buttonEl = $('.g-gallery-preview-toggle');
        const buttonTextMoreEl = buttonEl.find('.preview-toggle-more');
        const buttonTextLessEl = buttonEl.find('.preview-toggle-less');
        const galleryContainer = $('.g-gallery-preview-container');
        const dropzoneHeight = $('.dropzone-target').outerHeight();
        const previewRowHeight = 180 + dropzoneHeight;

        // Expand / hide preview button listener
        buttonEl.on('click', function (e) {
            galleryContainer.toggleClass('show');
            if (galleryContainer.hasClass('show')) {
                galleryContainer.css('maxHeight', previewContainer.outerHeight(true) + dropzoneHeight);
                buttonTextMoreEl.addClass('d-none');
                buttonTextLessEl.removeClass('d-none');
            }
            else {
                galleryContainer.css('maxHeight', previewRowHeight);
                buttonTextMoreEl.removeClass('d-none');
                buttonTextLessEl.addClass('d-none');
            }
        });

        // Display only the first row, display button when more are available > somewhat faulty on new upload / selection
        const previewContainerSize = previewContainer.outerHeight(true) + dropzoneHeight;
        if (previewContainerSize <= previewRowHeight) {
            buttonEl.addClass("d-none");
        }

        previewContainer.on('sort', function (e, ui) {
            if (!hiddenField) return;

            // Get mediaIds as array
            const array = hiddenField.value.split(',');
            // Get media Id of element to reposition
            const sortId = array[e.originalEvent.oldIndex];

            // Repositioning - remove from old position & insert in new position
            array.splice(e.originalEvent.oldIndex, 1);
            array.splice(e.originalEvent.newIndex, 0, sortId);

            // Save new order as string in hidden input field
            hiddenField.value = array.join(',');
        });

        dropzone.on('successmultiple', function (files, response, progress) {

            // Get entity id from response
            if (response.length) {
                files.forEach(function (file, i) {
                    file.id = response[i].id;
                });
            }
            else {
                files[0].id = response.id;
            }

            files.forEach(file => addFileToGallery(file));
        });

        fuContainer.on('mediaselected', function (e, files) {
            files.forEach(file => addFileToGallery(file));
        });

        fuContainer.on('click', '.delete-entity-picture', function (e) {
            const previewThumb = $(this).closest('.dz-image-preview')[0];
            removeMediaFromGallery(previewThumb);
        });

        const addFileToGallery = function (file) {
            // Display button to toggle preview container display
            if (parseInt(galleryContainer.css('maxHeight'), 10) > previewRowHeight) {
                buttonEl.removeClass("d-none");
            }

            if (!hiddenField || file.status === "error") return;

            createMediaPreview(file)

            // Add file id to hidden input field
            const id = file.media.id + ",";
            hiddenField.value = (hiddenField.value + id);

            // Display and expand preview container
            galleryContainer.addClass('show');
            galleryContainer.css('maxHeight', previewContainer.outerHeight(true) + dropzoneHeight);
        }

        const createMediaPreview = function (file) {
            // Create a preview for each new file or get existing
            const elPreview = file.previewElement ? $(file.previewElement) : $(previewTemplate.html());
            elPreview
                .attr('data-media-id', file.media.id)
                .attr('data-media-name', file.name)
                .attr('data-entity-id', file.id)
                .removeClass('d-none dz-processing')
                .addClass('dz-success');

            elPreview.find('.fu-file-info-name').html(file.name);
            elPreview.find('.file-img').attr('src', file.dataURL || file.media.thumbUrl);
            elPreview.find('.progress-bar').addClass('d-none');

            // Eventhandler to remove/unassign media
            elPreview.on('click', '.delete-entity-picture', { 'element': elPreview[0] }, function (e) {
                removeMediaFromGallery(e.data.element);
            });

            file.previewElement = elPreview;
            previewContainer.append(elPreview);
        }

        const removeMediaFromGallery = function (previewThumb) {
            if (!hiddenField || !previewThumb) return;

            const mediaId = previewThumb.dataset.mediaId;
            const array = hiddenField.value.split(',');
            if (!array.includes(mediaId)) return;

            // Remove media ids from hidden input and delete previewThumb
            array.splice(array.indexOf(mediaId), 1);
            hiddenField.value = array.join(',');
            previewThumb.remove();

            // Hide button if files preview container height is to small
            if (previewContainer.outerHeight(true) <= previewRowHeight) {
                buttonEl.addClass("d-none");
            }

            // File must be removed from dropzone if it was added in current queue
            if (dropzone.files.length > 0) {
                const file = dropzone.files.find(file => file.media.id == mediaId);
                if (file) {
                    dropzone.removeFile(file);
                }
            }
        }
    });

    const switchOn = function (el, value, ...compare) {
        el.toggleClass('d-none', !checkDisplay(value, compare))
    }

    const switchOff = function (el, value, ...compare) {
        el.toggleClass('d-none', checkDisplay(value, compare))
    }

    const checkDisplay = function (value, compare) {
        for (var i = 0; i < compare.length; i++) {
            if (compare[i].toLowerCase() == value.toLowerCase()) {
                return true;
            }
        }
        return false;
    }
</script>