@model MediaGalleryBlock

@using SmartStore.PageBuilder;
@using SmartStore.PageBuilder.Blocks;
@using SmartStore.Services.Media;

@{
    int? result = 0;
    var mediaFiles = new List<GalleryMediaFile>();
    if (Model.MediaIds.HasValue())
    {
        var fileIds = Model.MediaIds.ToIntArray();
        var files = this.CommonServices.Resolve<IMediaService>().GetFilesByIds(fileIds).ToList();
        mediaFiles = files.Select((value, index) =>
            new GalleryMediaFile
            {
                MediaFileId = value.Id,
                MediaFile = value.File,
                DisplayOrder = index
            }).ToList();
    }

    var aspectRatios = new List<SelectListItem>();
    aspectRatios.Add(new SelectListItem { Text = "1:1", Value = "1by1", Selected = Model.SelectedAspectRatio == "1by1" });
    aspectRatios.Add(new SelectListItem { Text = "2:1", Value = "2by1", Selected = Model.SelectedAspectRatio == "2by1" });
    aspectRatios.Add(new SelectListItem { Text = "4:3", Value = "4by3", Selected = Model.SelectedAspectRatio == "4by3" });
    aspectRatios.Add(new SelectListItem { Text = "5:4", Value = "5by4", Selected = Model.SelectedAspectRatio == "5by4" });
    aspectRatios.Add(new SelectListItem { Text = "16:9", Value = "16by9", Selected = Model.SelectedAspectRatio == "16by9" });
    aspectRatios.Add(new SelectListItem { Text = "16:10", Value = "16by10", Selected = Model.SelectedAspectRatio == "16by10" });
    aspectRatios.Add(new SelectListItem { Text = "21:9", Value = "21by9", Selected = Model.SelectedAspectRatio == "21by9" });
}

<div class="adminContent g-media-gallery-edit">
    <div class="adminRow">
        <div class="adminData wide">
            <div class="g-gallery-preview-container mb-3">
                @Html.EditorFor(model => result, "Media", new
                {
                    transientUpload = true,
                    path = "pagebuilder",
                    multifile = true,
                    uploadedFiles = mediaFiles,
                    typeFilter = "image,video"
                })
                @Html.HiddenFor(model => model.MediaIds, new { @id = "gallery-media-ids" })
            </div>

            <a class="g-gallery-preview-toggle btn btn-outline-light btn-clear w-100 mb-4">
                <i class="fa g-gallery-preview-toggle-icon"></i>
                <span class="g-gallery-preview-toggle-text">
                    <span class="preview-toggle-more">@T("Common.ShowMore")</span>
                    <span class="preview-toggle-less d-none">@T("Common.ShowLess")</span>
                </span>
            </a>
        </div>
    </div>
    <div class="adminRow">
        <div class="adminTitle">
            @Html.SmartLabelFor(model => model.Style)
        </div>
        <div class="adminData">
            @Html.DropDownListForEnum(model => model.Style, new { @id = "gallery-style" })
            @Html.ValidationMessageFor(model => model.Style)
        </div>
    </div>
    <div class="adminRow" id="gallery-media-size">
        <div class="adminTitle">
            @Html.SmartLabelFor(model => model.MediaSize)
        </div>
        <div class="adminData">
            @Html.EditorFor(model => model.MediaSize)
            @Html.ValidationMessageFor(model => model.MediaSize)
        </div>
    </div>
    <div class="adminRow" id="gallery-column-count">
        <div class="adminTitle">
            @Html.SmartLabelFor(model => model.ColumnCount)
        </div>
        <div class="adminData">
            @Html.EditorFor(model => model.ColumnCount)
            @Html.ValidationMessageFor(model => model.ColumnCount)
        </div>
    </div>
    <div class="adminRow" id="gallery-object-fit">
        <div class="adminTitle">
            @Html.SmartLabelFor(model => model.Fit)
        </div>
        <div class="adminData">
            @Html.DropDownListFor(model => model.Fit, StoryModelHelper.SelectOptions.BackgroundSizes(T, false).Where(x => x.Value != "auto"))
            @Html.ValidationMessageFor(model => model.Fit)
        </div>
    </div>
    <div class="adminRow" id="gallery-align-horizontal">
        <div class="adminTitle">
            @Html.SmartLabelFor(model => model.HorizontalAlign)
        </div>
        <div class="adminData">
            @Html.DropDownListFor(model => model.HorizontalAlign, StoryModelHelper.SelectOptions.GridJustifyContent(T), T("Common.Unspecified"))
            @Html.ValidationMessageFor(model => model.HorizontalAlign)
        </div>
    </div>
    <div class="adminRow" id="gallery-hover">
        <div class="adminTitle">
            @Html.SmartLabelFor(model => model.HoverEffect)
        </div>
        <div class="adminData">
            @Html.DropDownListFor(model => model.HoverEffect, StoryModelHelper.SelectOptions.BoxHoverEffects(T), T("Common.Unspecified"))
            @Html.ValidationMessageFor(model => model.HoverEffect)
