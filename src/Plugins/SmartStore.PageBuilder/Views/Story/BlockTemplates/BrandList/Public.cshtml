@model BrandListBlock

@using SmartStore.PageBuilder.Blocks;
@using SmartStore.Web.Models.Catalog;

@{
    if (Model.BrandListModel == null || Model.BrandListModel.Count == 0)
    {
        return;
    }

    var containerCssClasses = new List<string> { "g-block-brand-list" };
    var listCssClasses = new List<string> { "artlist", "artlist-grid" };

    if (Model.GrayscaleItems)
    {
        containerCssClasses.Add("grayscale-items");
    }

    if (Model.BrandListDisplayType == BrandListDisplayType.Slider)
    {
        containerCssClasses.Add("artlist-carousel");
    }

    listCssClasses.Add("artlist-{0}-cols".FormatInvariant((int)Model.ItemsPerRow));

    if (Model.BoxedStyleItems)
    {
        listCssClasses.Add("artlist-boxed");
    }
    if (Model.TitleDisplayType == TitleDisplayType.Above)
    {
        listCssClasses.Add("artlist-title-ontop");
    }
}

<div class="@String.Join(" ", containerCssClasses)">
    <div class='@String.Join(" ", listCssClasses)' data-slides-to-show="@Model.SlideItemsDisplayCount" data-slides-to-scroll="@Model.SlideItemsSlideCount">
        @foreach (var brand in Model.BrandListModel)
        {
            @RenderManufacturer(brand)
        }
    </div>
</div>

@helper RenderManufacturer(ManufacturerModel item)
{
    var picture = item.PictureModel;
    var url = Url.RouteUrl("Manufacturer", new { SeName = item.SeName });

    <article class="art" data-id="@item.Id">
        <div class="art-picture-block">
            @if (picture != null && picture.ImageUrl.HasValue())
            {
                <a class="art-picture img-center-container" href="@url" title="@picture.Title">
                    <img src="@picture.ImageUrl" alt="@picture.AlternateText" loading="lazy" />
                </a>
            }
        </div>

        @if (Model.DisplayTitle)
        {
            <div class="art-name">
                <a href="@url" title="@item.Name">
                    <span @Html.LanguageAttributes(item.Name)>@item.Name</span>
                </a>
            </div>
        }
    </article>
}