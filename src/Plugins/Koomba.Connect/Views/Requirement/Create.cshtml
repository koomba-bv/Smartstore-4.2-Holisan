@model ChainRuleModel

@{
    Layout = "_AdminLayout";
    //page title
    ViewBag.Title = T("Plugins.Koomba.Connect.Requirement.Create").Text;
}

@using (Html.BeginForm())
{
    <div class="section-header">
        <div class="title">
            @T("Plugins.Koomba.Connect.Requirement.Create")
            <a href="@Url.Action("Edit", "Configuration", new { id = Model.ConnectionId })">(@T("Plugins.Koomba.Connect.Connection.BackToList"))</a>
        </div>
        <div class="options">
            <button type="submit" name="save" value="save" class="btn btn-primary">
                <i class="fa fa-check"></i>
                <span>@T("Admin.Common.Save")</span>
            </button>
            <button type="submit" name="save" value="save-continue" class="btn btn-secondary">
                <span>@T("Admin.Common.SaveContinue")</span>
            </button>
        </div>
    </div>

    Html.RenderPartial("_CreateOrUpdate", Model);
}
