@model ColorOverlay

@using SmartStore.PageBuilder;

<div class="adminRow">
    <div class="adminTitle">
        @Html.SmartLabelFor(model => model.Color)
    </div>
    <div class="adminData">
        @Html.DropDownListFor(model => model.Color, StoryModelHelper.SelectOptions.BackgroundColors(T, GetThemeVariable("brand-colors")), T("Common.Unspecified"), new { @class = "theme-color-chooser" })
        @Html.ValidationMessageFor(model => model.Color)
    </div>
</div>