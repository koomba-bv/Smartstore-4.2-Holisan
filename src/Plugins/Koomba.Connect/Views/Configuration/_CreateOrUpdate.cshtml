@model ConnectionModel

@using Koomba.Connect.Domain

@Html.ValidationSummary(false)
@Html.HiddenFor(model => model.Id)
@Html.HiddenFor(model => model.SchedulingTaskId)

<table class="adminContent">
    @if (Model != null && Model.SchedulingTaskId > 0)
    {
        <tr>
            <td class="adminTitle">
                @Html.SmartLabelFor(x => x.SchedulingTaskId)
            </td>
            <td class="adminData">
                @{ Html.RenderAction("MinimalTask", "ScheduleTask", new { taskId = Model.SchedulingTaskId, returnUrl = Request.RawUrl, cancellable = true, reloadPage = true, area = "admin" }); }
            </td>
        </tr>
    }
</table>

@Html.SmartStore().TabStrip().Name("discount-edit").Style(TabsStyle.Material).Items(x =>
{
	x.Add().Text("Connection").Content(TabConnection()).Selected(true);
	x.Add().Text("Field Mapping").Content("Index", "Field", null);
	x.Add().Text("Requirements").Content("Index", "Requirement", Model);
	x.Add().Text("MultiRules").Content("MultiRule", "MultiRule", Model);
	x.Add().Text("Log").Content("Index", "Logger", Model);
})

