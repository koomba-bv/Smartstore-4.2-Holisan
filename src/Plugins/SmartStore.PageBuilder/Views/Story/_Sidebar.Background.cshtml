@model StoryModel

@using SmartStore.PageBuilder;

<div class="accordion overlay-editor-root sortable-list" id="se-overlays-editor" data-url-add="@Url.Action("OverlayAdd")">
    @if (Model.BackgroundModel.Overlays != null)
    {
        for (int i = 0; i < Model.BackgroundModel.Overlays.Count; i++)
        {
            var overlay = Model.BackgroundModel.Overlays[i];
            @Html.Action("OverlayEditor", new { overlay = overlay, expanded = false, region = "Stage" })
        }
    }
</div>

<div class="dropdown add-overlay-dropdown se-container mb-2 text-center" data-region="Stage">
    @{ Html.RenderPartial("Overlay.Chooser"); }
</div>