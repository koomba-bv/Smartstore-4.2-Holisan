@model ProductListBlock

@using SmartStore.Web.Framework;
@using SmartStore.Web.Framework.UI
@using SmartStore.PageBuilder.Blocks

<script>
    $(function () {

        // ProductPickingType
        $("#@Html.FieldIdFor(model => model.ProductPickingType)").change(togglePickingType);

        togglePickingType();

        function togglePickingType() {
            var selectedDisplayType = $("#@Html.FieldIdFor(model => model.ProductPickingType)").val();

            if (selectedDisplayType == 'Custom') {
                $('#category-picker').hide();
                $('#product-picker').show();
            }
            else {
                $('#category-picker').show();
                $('#product-picker').hide();
            }
        }

        // ProductDisplayType
        $("#@Html.FieldIdFor(model => model.ProductListDisplayType)").change(toggleDisplayType);

        toggleDisplayType();

        function toggleDisplayType() {
            var selectedDisplayType = $("#@Html.FieldIdFor(model => model.ProductListDisplayType)").val();

            if (selectedDisplayType == 'Grid') {
                $('.pnlItemsPerRow').show();
                $('.pnlBoxedStyleItems').show();
                $('.pnlSlideItemsDisplayCount').hide();
                $('.pnlSlideItemsSlideCount').hide();
                $('.product-prop-list').hide();
                $('.pnlDisplayButtons').show();
            }
            else if (selectedDisplayType == 'Slider') {
                $('.pnlItemsPerRow').hide();
                $('.pnlBoxedStyleItems').show();
                $('.pnlSlideItemsDisplayCount').show();
                $('.pnlSlideItemsSlideCount').show();
                $('.product-prop-list').hide();
                $('.pnlDisplayButtons').hide();
            }
            else if (selectedDisplayType == 'List') {
                $('.pnlBoxedStyleItems').hide();
                $('.pnlItemsPerRow').hide();
                $('.pnlSlideItemsDisplayCount').hide();
                $('.pnlSlideItemsSlideCount').hide();
                $('.product-prop-list').show();
                $('.pnlDisplayButtons').show();
            }
        }
    });
</script>

<div class="adminContent">
    <div class="adminRow">
        <div class="adminTitle">
            @Html.SmartLabelFor(model => model.ProductPickingType)
        </div>
        <div class="adminData">
            @Html.DropDownListForEnum(model => model.ProductPickingType)
            @Html.ValidationMessageFor(model => model.ProductPickingType)
        </div>
    </div>

    <div id="category-picker" class="adminRow">
        <div class="adminTitle">
            @Html.SmartLabelFor(model => model.CategoryId)
