@model ChildStoryBlock

@using SmartStore.PageBuilder.Blocks

@{ 
    var options = Model.AllStorySystemNames
        .Where(x => x.Key != Model.ParentStoryId)
        .OrderBy(x => x.Value)
        .Select(x => new SelectListItem
        {
            Value = x.Key.ToString(),
            Text = x.Value,
            Selected = x.Key == Model.StoryId
        });
}

<div class="adminContent">
	<div class="adminRow">
		<div class="adminTitle">
			@Html.SmartLabelFor(model => model.StoryId)
		</div>
		<div class="adminData">
			@Html.DropDownListFor(model => model.StoryId, options)
			@Html.ValidationMessageFor(model => model.StoryId)
		</div>
	</div>
</div>