<table class="adminContent">
    <tr class="toggle-teaser-rotator">
        <td class="adminTitle">
            @Html.SmartLabelFor(model => model.TeaserRotatorItemSelectType)
        </td>
        <td class="adminData">
            @Html.DropDownListForEnum(model => model.TeaserRotatorItemSelectType)
            @Html.ValidationMessageFor(model => model.TeaserRotatorItemSelectType)
        </td>
    </tr>
    <tr id="teaser-rotator-product-ids" class="toggle-teaser-rotator">
        <td class="adminTitle">
            @Html.SmartLabelFor(model => model.TeaserRotatorProductIds)
        </td>
        <td class="adminData">
            <div class="input-group">
                @Html.TextBoxFor(model => model.TeaserRotatorProductIds, new { data_routeparam = "productIds", @readonly = "readonly" })

                <span class="input-group-append">
                    <a class="btn btn-secondary" id="reset-rotator-productids" title="@T("Admin.Common.Reset")">
                        <i class="fa fa-times"></i>
                    </a>
                </span>

                <span class="input-group-append">
                    @(Html.SmartStore().EntityPicker()
                        .For(x => x.TeaserRotatorProductIds)
                        .Caption(T("Admin.Common.Search").Text.EncodeJsString('\'', false)))
                </span>
            </div>

            @Html.ValidationMessageFor(model => model.TeaserRotatorProductIds)
        </td>
    </tr>
    <tr id="max-rotator-items" class="toggle-teaser-rotator">
        <td class="adminTitle">
            @Html.SmartLabelFor(model => model.MaxRotatorItems)
        </td>
        <td class="adminData">
            @Html.EditorFor(model => model.MaxRotatorItems)
            @Html.ValidationMessageFor(model => model.MaxRotatorItems)
        </td>
    </tr>
</table>

<script>
    $(function () {
        // display bg picture
        $("#@Html.FieldIdFor(model => model.DisplayBgPicture)").click(toggleBgPicture);

        function toggleBgPicture() {
            if ($('#@Html.FieldIdFor(model => model.DisplayBgPicture)').is(':checked')) {
                $('.bg-picture').show();
                $('#mm-bg-link-localized').closest('tr').show();
            }
            else {
                $('.bg-picture').hide();
				$('#mm-bg-link-localized').closest('tr').hide();
            }
        }

        // display cat pic
        $("#@Html.FieldIdFor(model => model.DisplayCategoryPicture)").click(toggleCategoryPicture);

        function toggleCategoryPicture() {
            if ($('#@Html.FieldIdFor(model => model.DisplayCategoryPicture)').is(':checked')) {
                $('.cat-picture').show();
				$('#mm-short-summary').closest('tr').show();
            }
            else {
                $('.cat-picture').hide();
				$('#mm-short-summary').closest('tr').hide();
            }
        }

        // teaser
        var fieldTeaserType = $("#@Html.FieldIdFor(model => model.TeaserType)");
        fieldTeaserType.on("change", toogleTeaserControls);

        function toogleTeaserControls() {
            var type = fieldTeaserType.val();

            switch (type) {
                case 'Html':
                    $('.toggle-teaser-html').show();
					$('#mm-teaser-html').closest('tr').show();
                    $('.toggle-teaser-rotator').hide();
					$('#mm-rotator-heading').closest('tr').hide();
                    break;
                case 'Rotator':
                    $('.toggle-teaser-html').hide();
					$('#mm-teaser-html').closest('tr').hide();
                    $('.toggle-teaser-rotator').show();
					$('#mm-rotator-heading').closest('tr').show();
                    fieldTeaserRotatorSelectType.trigger("change");
                    break;
                default:
                    $('.toggle-teaser-html, .toggle-teaser-rotator').hide();
					$('#mm-rotator-heading, #mm-teaser-html').closest('tr').hide();
                    break;
            }
        }

        var fieldTeaserRotatorSelectType = $("#@Html.FieldIdFor(model => model.TeaserRotatorItemSelectType)");
        fieldTeaserRotatorSelectType.on("change", toogleTeaserRotatorSelectTypeControls);

        function toogleTeaserRotatorSelectTypeControls() {
            var type = fieldTeaserRotatorSelectType.val();

            if (type == "Custom") {
                $("#teaser-rotator-product-ids").show();
                $("#max-rotator-items").hide();
            }
            else {
                $("#max-rotator-items").show();
                $("#teaser-rotator-product-ids").hide();
            }
        }

        // init
        $('.toggle-teaser-html, .toggle-teaser-rotator').hide();
        toggleBgPicture();
        toggleCategoryPicture();
        fieldTeaserRotatorSelectType.trigger("change");
		fieldTeaserType.trigger("change");

		// reset rotator product ids
		$("#reset-rotator-productids").on("click", function (e) {
			e.preventDefault();
			$("#@Html.FieldIdFor(model => model.TeaserRotatorProductIds)").val("");
		});
    });
</script>
