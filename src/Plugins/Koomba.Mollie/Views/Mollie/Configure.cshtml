@model Koomba.Mollie.Models.ConfigurationModel
@using SmartStore.Web.Framework;
@{
    Layout = "";
}

<div class="plugin-actions">
    <button type="submit" name="save" value="save" class="btn btn-warning">
        <i class="fa fa-check"></i>
        <span>@T("Admin.Common.Save")</span>
    </button>
</div>	

@Html.Action("StoreScopeConfiguration", "Setting", new { area = "Admin" })

<div class="alert alert-info">
    @Html.Raw(@T("Plugins.Koomba.Mollie.AdminInstruction"))
</div>

@using (Html.BeginForm())
{
    <div class="adminContent">
        <div class="adminRow">
            <div class="adminTitle">
                @Html.SmartLabelFor(model => model.ApiKey)
            </div>
            <div class="adminData">
                @Html.SettingEditorFor(model => model.ApiKey)
                @Html.ValidationMessageFor(model => model.ApiKey)
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle">
                @Html.SmartLabelFor(model => model.LocalHost)
            </div>
            <div class="adminData">
                @Html.SettingEditorFor(model => model.LocalHost)
                @Html.ValidationMessageFor(model => model.LocalHost)
            </div>
        </div>
        <div class="adminRow">
            <div class="adminTitle">
                @Html.SmartLabelFor(model => model.RoleRestrictionIds)
            </div>
            <div class="adminData">
                @Html.ListBoxFor(model => model.RoleRestrictionIds, Model.Roles)
                @Html.ValidationMessageFor(model => model.RoleRestrictionIds)
            </div>
        </div>
    </div>
}