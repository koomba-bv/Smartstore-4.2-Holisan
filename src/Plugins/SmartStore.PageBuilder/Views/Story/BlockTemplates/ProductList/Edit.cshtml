                    <a class="btn btn-secondary" id="reset-block-product-ids" title="@T("Admin.Common.Reset")">
                        <i class="fa fa-times"></i>
                    </a>
                </span>
                <span class="input-group-append">
                    @(Html.SmartStore().EntityPicker()
                        .For(x => x.ProductIds)
                        .MaxItems(100)
                        .EntityType("product")
                        .DialogTitle(T("Common.Entity.SelectProduct").Text.EncodeJsString('\'', false))
                        .Caption(T("Admin.Common.Search").Text.EncodeJsString('\'', false)))
                </span>
            </div>
            @Html.ValidationMessageFor(model => model.ProductIds)
        </div>
    </div>

